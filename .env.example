BOT_TOKEN=
FORCE_CHANNELS=@yourchannel

# Optional Telegram webhook mode. Leave both blank to use polling.
WEBHOOK_URL=
WEBHOOK_SECRET=

# Public base URL used for demo receipt links.
PUBLIC_BASE_URL=https://usdt09.onrender.com

# Optional: Telegram group/channel ID for clearly-labelled demo withdrawal posts.
# Example: -1001234567890
DEMO_PROOF_CHAT_ID=

# SQLite path. Render Free filesystem is ephemeral; data may be lost on redeploy/restart.
DATABASE_PATH=usdt09.sqlite3

LOG_LEVEL=INFO
