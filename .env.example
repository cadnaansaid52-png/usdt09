# Required: create a bot with @BotFather and paste its token here.
BOT_TOKEN=

# Public example: @channel_one;@channel_two
# Private example: -1001234567890|https://t.me/+INVITE_CODE|Private channel
FORCE_CHANNELS=@yourchannel

# Render webhook mode (recommended for a deployed web service).
# Set this to the base URL assigned by Render, without /webhook.
WEBHOOK_URL=
# Use a strong random value: only A-Z, a-z, 0-9, _ and -.
WEBHOOK_SECRET=

LOG_LEVEL=INFO
